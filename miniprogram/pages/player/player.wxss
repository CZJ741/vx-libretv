.player-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #0b0f19;
}

.video-wrapper {
  width: 100%;
  height: 422rpx;
  background-color: #000000;
}

.video-player {
  width: 100%;
  height: 100%;
}

.control-panel {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.video-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f8fafc;
  flex: 1;
}

.source-tag {
  background-color: #1e293b;
  color: #38bdf8;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(56, 189, 248, 0.3);
  margin-left: 16rpx;
}

.current-episode-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.episodes-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #131b2e;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1px solid #1e293b;
  overflow: hidden;
}

.episodes-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.episodes-scroll {
  flex: 1;
  height: 0;
}

.episodes-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding-bottom: 20rpx;
}

/* 长剧集名模式（综艺/副标题等）自动切换为双列排布 */
.episodes-grid.long-text-mode {
  grid-template-columns: repeat(2, 1fr);
}

.ep-btn {
  background-color: #1e293b;
  border: 1px solid #334155;
  border-radius: 10rpx;
  padding: 18rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #cbd5e1;
  font-size: 24rpx;
  min-width: 0; /* 约束 Flex/Grid 宽度，确保文本溢出省略号生效 */
  box-sizing: border-box;
}

.ep-btn.active {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-color: #3b82f6;
  color: #ffffff;
  font-weight: bold;
}

.ep-btn .ellipsis {
  width: 100%;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  word-break: break-all;
}
